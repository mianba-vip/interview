loki.source.file "backend" {
  targets = [{ __path__ = "/app/logs/*.log", job = "mianba-backend" }]
  forward_to = [loki.write.local.receiver]
  tail_from_end = true
  file_match {
    enabled = true
    sync_period = "10s"
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
