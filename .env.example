# kg-forge 环境变量（与 interview 后端 .env 分开维护；compose 里通过 environment 注入）

# 服务间共享密钥（必改）：interview 后端 app.forge.secret 与此一致
FORGE_SECRET=change-me-forge-secret

# LangGraph checkpointer 的 PostgreSQL（复用 interview 的 PG 实例；自建 ckpt_* 表）
FORGE_DB_URL=postgresql://postgres:123456@postgres:5432/interview

# 服务端兜底 LLM（本地单机可配；云端多用户建议留空强制 BYOK）
FORGE_API_KEY=
FORGE_BASE_URL=https://api.deepseek.com
FORGE_MODEL=deepseek-chat

FORGE_PORT=8100
